{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vision-evidence/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "source_sha256",
    "image_sha256",
    "producer",
    "status",
    "verbatim_text",
    "uncertain_regions"
  ],
  "properties": {
    "schema_version": { "const": "vision-evidence/v2" },
    "task_id": { "type": "string", "pattern": "^vis_[0-9a-f]{20}$" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "image_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_name", "model"],
      "properties": {
        "agent_name": { "const": "纠纷材料视觉核验员" },
        "model": { "const": "Doubao-Seed-2.1-turbo" }
      }
    },
    "status": { "enum": ["complete", "partial", "failed"] },
    "verbatim_text": { "type": "string" },
    "uncertain_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "critical"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "critical": { "type": "boolean" },
          "source_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["complete", "partial"] } },
        "required": ["status"]
      },
      "then": {
        "properties": { "verbatim_text": { "type": "string", "pattern": "\\S" } }
      }
    }
  ]
}
